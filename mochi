    background: #fffafd;
    border: 2px solid #ffb6d0;
    border-radius: 26px;
    padding: 24px 16px;
    text-align: center;
}
.pet {
    font-size: 115px;
    text-align: center;
    padding: 8px;
}
.bubble {
    background: white;
    border: 1px solid #ffc2d8;
    border-radius: 18px;
    padding: 16px;
    text-align: center;
    color: #94365f;
    font-size: 18px;
}
h1, h2, h3 {
    color: #d63372;
}
div.stButton > button {
    width: 100%;
    min-height: 48px;
    border-radius: 14px;
    border: 1px solid #ff8db5;
    background: #ff5b96;
    color: white;
    font-weight: bold;
}
div.stButton > button:hover {
    background: #e8437c;
    color: white;
}
</style>
""", unsafe_allow_html=True)

st.markdown("""
<div class="hero">
    <div style="font-size:42px">💗 🐾 💗</div>
    <h1>Hana's Little Virtual Pet</h1>
    <p>A tiny friend made to bring you a little happiness.</p>
</div>
""", unsafe_allow_html=True)

st.write("")

# Pet name and status
st.markdown(
    f'<div class="pet">🐱</div>',
    unsafe_allow_html=True,
)

st.markdown(
    f'<div class="bubble"><b>{st.session_state.pet_name} says:</b>'
    f'<br>{st.session_state.message}</div>',
    unsafe_allow_html=True,
)

st.write("")

a, b, c = st.columns(3)
a.metric("💖 Hearts", st.session_state.hearts)
b.metric("⭐ Level", st.session_state.level)
c.metric("🐱 Best friend", "Hana")

st.subheader("How is Mochi feeling?")

for label, key, emoji in [
    ("Happiness", "happiness", "😊"),
    ("Fullness", "fullness", "🍓"),
    ("Energy", "energy", "⚡"),
]:
    st.write(f"{emoji} **{label}: {st.session_state[key]}/100**")
    st.progress(st.session_state[key] / 100)

st.subheader("Spend time with Mochi")

left, right = st.columns(2)

with left:
    if st.button("🍓 Feed Mochi"):
        act("feed")
        st.rerun()

    if st.button("🫂 Give a hug"):
        act("hug")
        st.rerun()

with right:
    if st.button("🎾 Play together"):
        act("play")
        st.rerun()

    if st.button("🌙 Take a nap"):
        act("sleep")
        st.rerun()

st.subheader("🎁 Secret surprises")

if st.session_state.hearts >= 10:
    st.success("You unlocked Mochi's special letter! 💌")
    st.markdown("""
    > Dear Hana,
    >
    > Just like Mochi's little world gets brighter
    > when you visit, I hope you always find reasons
    > to smile. You deserve all the lovely things
    > life has to offer. 💗
    >
    > — Lix Aldrin
    """)
else:
    remaining = 10 - st.session_state.hearts
    st.info(
        f"Collect {remaining} more hearts "
        "to unlock a special letter! 💌"
    )

with st.expander("✏️ Change Mochi's name"):
    new_name = st.text_input(
        "Choose a pet name",
        value=st.session_state.pet_name,
        max_chars=20,
    )
    if st.button("Save name"):
        if new_name.strip():
            st.session_state.pet_name = new_name.strip()
            st.session_state.message = (
                f"{new_name.strip()} says hello to Hana! 💗"
            )
            st.rerun()

st.divider()
st.markdown(
    "<center>Made with courage and ❤️ by Lix Aldrin</center>",
    unsafe_allow_html=True,
)
