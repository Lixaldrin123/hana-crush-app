
import random
import streamlit as st

st.set_page_config(
    page_title="Hana & Mochi 🐱",
    page_icon="🐱",
    layout="centered",
)

# Initialize pet data for this session
defaults = {
    "happiness": 70,
    "fullness": 70,
    "energy": 70,
    "hearts": 0,
    "level": 1,
    "message": "Mochi is so happy to see you, Hana! 💗",
    "pet_name": "Mochi",
    "unlocked_notes": [],
}

for key, value in defaults.items():
    if key not in st.session_state:
        st.session_state[key] = value


def clamp(value):
    return max(0, min(100, value))


def act(action):
    s = st.session_state

    if action == "feed":
        s.fullness = clamp(s.fullness + 20)
        s.happiness = clamp(s.happiness + 5)
        s.hearts += 1
        s.message = random.choice([
            "Meeeow! That was delicious! 🍓",
            "Mochi's tummy is full. Thank you, Hana! 💗",
            "You always know my favorite snacks! 🐾",
        ])

    elif action == "play":
        if s.energy < 10:
            s.message = "Mochi is sleepy! Let's take a nap first. 🌙"
            return

        s.happiness = clamp(s.happiness + 18)
        s.energy = clamp(s.energy - 12)
        s.fullness = clamp(s.fullness - 5)
        s.hearts += 2
        s.message = random.choice([
            "Wheeee! Let's play again! 🎾",
            "You're my favorite playmate, Hana! 💕",
            "That was so much fun! 🐾",
        ])

    elif action == "hug":
        s.happiness = clamp(s.happiness + 12)
        s.hearts += 1
        s.message = random.choice([
            "Big virtual hug for Hana! 🫂",
            "Purr purr... Mochi loves cuddles! 💗",
            "You made my little heart happy! 🐱",
        ])

    elif action == "sleep":
        s.energy = clamp(s.energy + 25)
        s.message = "Zzz... Mochi is dreaming of fish and flowers. 🌙"

    # Level up every 10 hearts
    new_level = 1 + s.hearts // 10
    if new_level > s.level:
        s.level = new_level
        s.message += f" ✨ LEVEL UP! Welcome to Level {new_level}!"

    # Unlock a special note at 10 hearts
    if s.hearts >= 10 and 2 not in s.unlocked_notes:
        s.unlocked_notes.append(2)


st.markdown("""
<style>
.stApp {
    background: linear-gradient(180deg, #fff0f6, #ffe0eb);
}
.block-container {
    max-width: 720px;
    padding-top: 2rem;
}
